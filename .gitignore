# Simulation work libraries
work/
*.wlf
*.vstf
transcript

# VCD / SAIF (large generated files)
*.vcd
*.saif

# Synthesis outputs (submission/outputs/ is submitted, except the large VCD / SAIF / logs)
/outputs/
*.dat
*.db
*.svf
!submission/outputs/*.dat

# Genus / QuestaSim temp dirs
genus.*/
fv/
*.log
*.cmd

# Generated tool logs (large, not needed in repo); the empty folders are kept
submission/syn_logs/*
submission/pnr_logs/*
!submission/syn_logs/.gitkeep
!submission/pnr_logs/.gitkeep

# Place and route checkpoints: every stage's checkpoint is submitted, so nothing in checkpoints/ is ignored
!submission/pnr_outputs/checkpoints/
!submission/pnr_outputs/checkpoints/**

# Student submission archives
solution/submissions/

# OS / editor
.DS_Store
*.swp
*~
__pycache__/

.vscode/
